{
  "name": "firefox-markdown",
  "version": "1.1.6",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.js",
    "install:firefox": "node build.js && node install.js",
    "watch": "node build.js --watch",
    "release": "node release.js",
    "sign:ci": "node build.js && web-ext sign -s . -a ./web-ext-artifacts -i src node_modules pnpm-lock.yaml .aiwork .git --channel=unlisted",
    "test:open": "firefox test.md"
  },
  "dependencies": {
    "@shikijs/core": "^3.21.0",
    "marked": "^15.0.0",
    "mermaid": "^11.12.2",
    "shiki": "^1.24.0"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "esbuild": "^0.24.0",
    "web-ext": "^8.0.0"
  },
  "packageManager": "pnpm@10.33.0"
}